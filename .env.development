# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址
VITE_API_URL = /api
# VITE_API_URL_form = /api/formapi
# 开发环境跨域代理，支持配置多个

# 本地
# VITE_PROXY = [["/api","http://192.168.1.12:8686"]]
# VITE_IMAGE_SERVER = http://192.168.1.12:8686 # 图片服务器地址（开发环境）
#刘博
# VITE_PROXY = [["/api","http://192.168.110.33:8686"]]
# 段
VITE_PROXY = [["/api","http://192.168.1.13:8686"]]
VITE_IMAGE_SERVER = http://192.168.1.13:8686 # 图片服务器地址（开发环境）
